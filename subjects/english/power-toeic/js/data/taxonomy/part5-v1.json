  "micro_skills": [
    {"id":"p5.pos.adjective_before_noun","group":"parts-of-speech","label_ja":"名詞の前の形容詞","rule_ja":"名詞を直接修飾する位置では形容詞を選ぶ。","confusion":"adjective_vs_other_word_forms"},
    {"id":"p5.pos.adverb_modifies_verb","group":"parts-of-speech","label_ja":"動詞を修飾する副詞","rule_ja":"動作・動詞句を修飾する位置では副詞を選ぶ。","confusion":"adjective_vs_adverb"},
    {"id":"p5.pos.noun_in_noun_slot","group":"parts-of-speech","label_ja":"名詞位置の語形","rule_ja":"主語・目的語など名詞位置では名詞形を選ぶ。","confusion":"noun_vs_other_word_forms"},
    {"id":"p5.pos.adjective_after_linking_verb","group":"parts-of-speech","label_ja":"連結動詞後の形容詞","rule_ja":"be/seem/remain/become/appear等の補語位置では形容詞を選ぶ。","confusion":"adjective_vs_adverb"},
    {"id":"p5.pos.adverb_modifies_adjective","group":"parts-of-speech","label_ja":"形容詞を修飾する副詞","rule_ja":"形容詞の程度・様態を修飾する位置では副詞を選ぶ。","confusion":"adverb_vs_adjective"},
    {"id":"p5.pos.participle_adjective_ed_ing","group":"parts-of-speech","label_ja":"-ed/-ing形容詞","rule_ja":"感情を受ける側と引き起こす側を区別して分詞形容詞を選ぶ。","confusion":"ed_vs_ing_adjective"},
    {"id":"p5.pos.word_form_subject_position","group":"parts-of-speech","label_ja":"主語位置の語形","rule_ja":"文の主語位置で名詞・名詞句として機能する形を選ぶ。","confusion":"noun_vs_adjective"},
    {"id":"p5.pos.word_form_object_position","group":"parts-of-speech","label_ja":"目的語位置の語形","rule_ja":"他動詞の目的語位置で名詞・名詞句として機能する形を選ぶ。","confusion":"noun_vs_adverb"},
    {"id":"p5.verb.subject_verb_agreement","group":"verbs","label_ja":"主語と動詞の一致","rule_ja":"主語の数・人称に合わせて動詞形を選ぶ。","confusion":"singular_vs_plural_agreement"},
    {"id":"p5.verb.present_vs_past","group":"verbs","label_ja":"現在形と過去形","rule_ja":"明示された時点・習慣・完了済み事実から現在/過去を選ぶ。","confusion":"present_vs_past"},
    {"id":"p5.verb.present_perfect_vs_past","group":"verbs","label_ja":"現在完了と過去","rule_ja":"現在とのつながりと完結した過去時点を区別する。","confusion":"past_vs_present_perfect"},
    {"id":"p5.verb.active_vs_passive","group":"verbs","label_ja":"能動態と受動態","rule_ja":"主語が動作主か被動作対象かで態を選ぶ。","confusion":"active_vs_passive"},
    {"id":"p5.verb.modal_base_form","group":"verbs","label_ja":"助動詞＋原形","rule_ja":"助動詞の直後では動詞原形を選ぶ。","confusion":"modal_verb_form"},
    {"id":"p5.verb.to_infinitive_pattern","group":"verbs","label_ja":"to不定詞を取る動詞","rule_ja":"to不定詞を要求する動詞語法を識別する。","confusion":"infinitive_vs_gerund"},
    {"id":"p5.verb.gerund_pattern","group":"verbs","label_ja":"動名詞を取る動詞","rule_ja":"動名詞を要求する動詞語法を識別する。","confusion":"gerund_vs_infinitive"},
    {"id":"p5.verb.causative_have_make_let","group":"verbs","label_ja":"使役構文","rule_ja":"have/make/let等の補語形を構文に応じて選ぶ。","confusion":"causative_complement"},
    {"id":"p5.verb.conditional_form","group":"verbs","label_ja":"条件節の動詞形","rule_ja":"条件節と主節の時制・法の対応を選ぶ。","confusion":"conditional_verb_form"},
    {"id":"p5.verb.participle_clause","group":"verbs","label_ja":"分詞構文","rule_ja":"主節との主語関係・態から現在分詞/過去分詞を選ぶ。","confusion":"present_vs_past_participle"},
    {"id":"p5.conn.preposition_vs_conjunction","group":"connectors-prepositions","label_ja":"前置詞と接続詞","rule_ja":"後続が名詞句か節かで前置詞/接続詞を選ぶ。","confusion":"preposition_vs_conjunction"},
    {"id":"p5.conn.because_vs_because_of","group":"connectors-prepositions","label_ja":"because / because of","rule_ja":"後続構造に応じてbecauseとbecause ofを区別する。","confusion":"because_vs_because_of"},
    {"id":"p5.conn.despite_vs_although","group":"connectors-prepositions","label_ja":"despite / although","rule_ja":"譲歩表現で後続が名詞句か節かを見分ける。","confusion":"despite_vs_although"},
    {"id":"p5.conn.during_vs_while","group":"connectors-prepositions","label_ja":"during / while","rule_ja":"期間名詞句と節の違いからduring/whileを選ぶ。","confusion":"during_vs_while"},
    {"id":"p5.conn.by_vs_until","group":"connectors-prepositions","label_ja":"by / until","rule_ja":"期限までの完了と継続の終点を区別する。","confusion":"by_vs_until"},
    {"id":"p5.conn.for_vs_since","group":"connectors-prepositions","label_ja":"for / since","rule_ja":"期間と起点を区別する。","confusion":"for_vs_since"},
    {"id":"p5.conn.time_prepositions","group":"connectors-prepositions","label_ja":"in / on / at（時間）","rule_ja":"時間表現の粒度に応じてin/on/atを選ぶ。","confusion":"time_preposition_choice"},
    {"id":"p5.conn.logical_conjunction","group":"connectors-prepositions","label_ja":"論理関係の接続詞","rule_ja":"追加・対比・理由・結果など文脈上の論理関係を選ぶ。","confusion":"conjunction_semantic_relation"},
    {"id":"p5.pron.subject_vs_object","group":"pronouns-relatives","label_ja":"主格・目的格代名詞","rule_ja":"文中の統語位置から主格/目的格を選ぶ。","confusion":"subject_vs_object_pronoun"},
    {"id":"p5.pron.possessive_forms","group":"pronouns-relatives","label_ja":"所有格・所有代名詞","rule_ja":"後続名詞の有無から所有形容詞/所有代名詞を選ぶ。","confusion":"possessive_adjective_vs_pronoun"},
    {"id":"p5.pron.reflexive","group":"pronouns-relatives","label_ja":"再帰代名詞","rule_ja":"主語と目的語の同一性や強調用法から再帰形を選ぶ。","confusion":"reflexive_pronoun"},
    {"id":"p5.rel.who_vs_which","group":"pronouns-relatives","label_ja":"who / which","rule_ja":"先行詞が人か物かを基本に関係代名詞を選ぶ。","confusion":"relative_pronoun_choice"},
    {"id":"p5.rel.whose","group":"pronouns-relatives","label_ja":"whose","rule_ja":"関係節内で所有関係を表す必要があるか判定する。","confusion":"relative_possessive"},
    {"id":"p5.rel.where_vs_when","group":"pronouns-relatives","label_ja":"where / when","rule_ja":"先行詞が場所か時かを判定する。","confusion":"relative_adverb_choice"},
    {"id":"p5.pron.indefinite_agreement","group":"pronouns-relatives","label_ja":"不定代名詞と一致","rule_ja":"each/everyone/neither等の数扱いに合わせて一致させる。","confusion":"indefinite_pronoun_agreement"},
    {"id":"p5.det.article_choice","group":"determiners-quantity","label_ja":"冠詞 a/an/the/無冠詞","rule_ja":"可算性・特定性・初出/既出から冠詞を選ぶ。","confusion":"article_choice"},
    {"id":"p5.det.countable_number","group":"determiners-quantity","label_ja":"可算名詞の単複","rule_ja":"限定詞や数量表現に合わせて単数/複数を選ぶ。","confusion":"singular_vs_plural_noun"},
    {"id":"p5.det.much_vs_many","group":"determiners-quantity","label_ja":"much / many","rule_ja":"不可算/可算複数を区別して数量詞を選ぶ。","confusion":"much_vs_many"},
    {"id":"p5.det.few_vs_little","group":"determiners-quantity","label_ja":"few / little","rule_ja":"可算/不可算と意味ニュアンスを区別する。","confusion":"few_vs_little"},
    {"id":"p5.det.another_other_others","group":"determiners-quantity","label_ja":"another / other / others","rule_ja":"後続名詞の有無と単複から形を選ぶ。","confusion":"another_other_others"},
    {"id":"p5.vocab.verb_noun_collocation","group":"vocabulary-usage","label_ja":"動詞＋名詞コロケーション","rule_ja":"自然な動詞＋名詞の組み合わせを選ぶ。","confusion":"collocation_choice"},
    {"id":"p5.vocab.adjective_noun_collocation","group":"vocabulary-usage","label_ja":"形容詞＋名詞コロケーション","rule_ja":"業務文脈で自然な形容詞＋名詞の組み合わせを選ぶ。","confusion":"collocation_choice"},
    {"id":"p5.vocab.preposition_collocation","group":"vocabulary-usage","label_ja":"前置詞コロケーション","rule_ja":"語に固定的に結びつく前置詞を選ぶ。","confusion":"preposition_collocation"},
    {"id":"p5.vocab.phrasal_verb","group":"vocabulary-usage","label_ja":"句動詞","rule_ja":"文脈と目的語から適切な句動詞を選ぶ。","confusion":"phrasal_verb_choice"},
    {"id":"p5.vocab.business_context","group":"vocabulary-usage","label_ja":"業務文脈語彙","rule_ja":"会議・物流・採用・契約等の文脈から適切な語を選ぶ。","confusion":"context_vocabulary"},
    {"id":"p5.vocab.confusing_words","group":"vocabulary-usage","label_ja":"類義・混同語","rule_ja":"同じ品詞の近似語から意味・語法に合う一語を選ぶ。","confusion":"semantic_confusion"}
  ]
}
